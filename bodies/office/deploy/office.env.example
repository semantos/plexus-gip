# /etc/vouch-office/<attestor>.env, read by vouch-office@<attestor>.service.
# No secret goes here: the keys, the roster and the registrars are in the state file.

# The port the office listens on, on 127.0.0.1. One per attestor on the host.
OFFICE_PORT=8781
# Only for a Helm served from another origin than the brain's own host: that
# origin, so a browser there may read the desk's answers. The Helm the brain
# serves is on the brain's host and needs nothing here.
OFFICE_DESK_ORIGIN=
