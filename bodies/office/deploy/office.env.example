# /etc/vouch-office/<attestor>.env, read by vouch-office@<attestor>.service.
# No secret goes here: the keys and the roster are in the state file.

# The port the office listens on, on 127.0.0.1. One per attestor on the host.
OFFICE_PORT=8781
# Where the registrar's desk is served from: the attestor's brain, which serves the Helm.
OFFICE_DESK_ORIGIN=https://brain.hillside.example.edu.au
