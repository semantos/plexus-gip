# The vouch office's public site for one attestor, behind the same Caddy as
# its brain (bodies/office/deploy/README.md). Add this site to
# /etc/caddy/Caddyfile beside the brain's, and replace the office's host and
# port with those in /etc/vouch-office/<attestor>.env. The registrar's desk is
# not here: it is on the brain's own host, behind the brain's login
# (brain-desk.caddy).
#
# No `log` here: a pickup URL is a secret until it is used, and an access log
# would keep it.

vouch.hillside.example.edu.au {
	# Public: the body's DID document and withdrawal list, which apps check
	# against, and the pickup and collect routes a family's phone and a
	# child's device use. None of them carries a name.
	@public path /.well-known/did.json /status/* /pickup/* /collect
	handle @public {
		reverse_proxy 127.0.0.1:8781 {
			# No caller reaches the office from this site, whatever a client
			# sends: a path such as /pickup/../desk/roster comes out at the
			# office as /desk/roster.
			header_up -X-Semantos-Standing
			header_up -X-Semantos-Cert-Id
		}
	}

	handle {
		respond 404
	}
}
